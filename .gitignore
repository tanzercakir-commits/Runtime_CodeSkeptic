# Build output
build/
build-*/
cmake-build-*/
out/

# Generated profiles are machine-specific. The directory is tracked (see its
# .gitkeep) but its contents are not, because a profile measured on one host is
# evidence about that host only. Check one in deliberately, with a name that
# says which machine it came from, if you want it as a fixture.
profiles/generated/*.json

# Generated reports
reports/*.md
reports/*.json
reports/*.txt

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
compile_commands.json

# The demo bundle in contracts/generated/ IS tracked (it is a fixture), but
# anything else produced by a CodeSkeptic run is not.
contracts/generated/*.local.json

# Campaign working directories. The measured RESULT is committed under
# campaigns/; the multi-megabyte strace traces and generated bundles behind it
# are regenerated by tools/campaign/run_false_positive.sh.
build/false-positive/

# Python bytecode. `python3 -m py_compile` on a guard leaves this behind, and it
# was staged once by `git add -A` before being noticed.
__pycache__/
*.pyc

# release artifacts (binaries ship as GitHub Release assets, not in git)
dist/*.tar.gz
dist/runtimeskeptic-v*/
